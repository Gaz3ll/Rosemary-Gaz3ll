<!--
    Paleta jasna (domyślna). Wszystkie kolory interfejsu pochodzą z tego słownika,
    dzięki czemu motyw ciemny sprowadza się do podmiany zasobów, a nie do modyfikacji widoków.
    Kolory są wiązane jako DynamicResource, aby przełączenie motywu działało w locie.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Powierzchnie -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2F5F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F7F9FB" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#D5DCE3" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#E8EDF2" />

    <!-- Tekst -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#888888" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentMutedBrush" Color="#BBD3EA" />

    <!-- Akcenty -->
    <SolidColorBrush x:Key="HeaderBrush" Color="#1F3A5F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6DA4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D82BC" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7E45" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B8860B" />

    <!-- Baner ostrzeżenia -->
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E0B400" />

    <!-- Kolory kategorii Triage -->
    <SolidColorBrush x:Key="TriageRedBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="TriageOrangeBrush" Color="#D35400" />
    <SolidColorBrush x:Key="TriageYellowBrush" Color="#B7950B" />
    <SolidColorBrush x:Key="TriageGreenBrush" Color="#1E8449" />
    <SolidColorBrush x:Key="TriageBlueBrush" Color="#2471A3" />
<!-- Pastelowo-rozowe tla paneli (specyfikacja interfejsu): jednostka organizacyjna,
         zakres dat i filtry statusowe oraz dolny pasek zakladek. -->
    <SolidColorBrush x:Key="PanelPinkBrush" Color="#FCE4EC" />
    <SolidColorBrush x:Key="PanelPinkAltBrush" Color="#F8D7E3" />
    <SolidColorBrush x:Key="PanelPinkHeaderBrush" Color="#F3B6C9" />
    <SolidColorBrush x:Key="PanelPinkBorderBrush" Color="#E39CB4" />
    <SolidColorBrush x:Key="PanelPinkTextBrush" Color="#5B2333" />
</ResourceDictionary>
