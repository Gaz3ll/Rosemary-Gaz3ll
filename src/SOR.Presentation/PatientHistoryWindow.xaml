<Window x:Class="SOR.Presentation.PatientHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="720" Width="1000" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- Historia pobytu: dane przyjecia, oceny Triage, przeniesienia, zlecenia (procedury
         i badania), podane leki oraz wypisy. Kolor pochodza z motywu (DynamicResource). -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Naglowek: identyfikacja pacjenta i podsumowanie pobytu -->
        <Border Grid.Row="0" Style="{StaticResource SurfaceCard}">
            <StackPanel>
                <TextBlock Text="{Binding Details.FullName, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                <TextBlock Style="{StaticResource FieldHint}">
                    <Run Text="PESEL " /><Run Text="{Binding Details.Pesel, Mode=OneWay}" />
                    <Run Text="  |  " /><Run Text="{Binding Age, Mode=OneWay}" /><Run Text=" lat" />
                    <Run Text="  |  płeć: " /><Run Text="{Binding Details.Gender, Converter={StaticResource PolishEnum}, Mode=OneWay}" />
                    <Run Text="  |  stan: " /><Run Text="{Binding Details.State, Converter={StaticResource PolishEnum}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource FieldHint}">
                    <Run Text="Przyjęcie: " /><Run Text="{Binding AdmissionDisplay, Mode=OneWay}" />
                    <Run Text="  |  strefa: " /><Run Text="{Binding ZoneDisplay, Mode=OneWay}" />
                    <Run Text="  |  triage: " /><Run Text="{Binding Details.Triage, Converter={StaticResource PolishEnum}, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource FieldHint}">
                    <Run Text="Rozpoznanie ICD-10: " /><Run Text="{Binding DiagnosisDisplay, Mode=OneWay}" />
                    <Run Text="  |  wypis: " /><Run Text="{Binding DischargeDisplay, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Zgłaszane dolegliwości" />
                <TextBlock Text="{Binding ComplaintDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Blokady wypisu" />
                <ItemsControl ItemsSource="{Binding Details.DischargeBlockers, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Mode=OneWay}" Foreground="{DynamicResource WarningBorderBrush}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource FieldHint}"
                           Text="Brak blokad wypisu."
                           Visibility="{Binding HasDischargeBlockers, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Sekcje historii pobytu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding TriageSectionHeader, Mode=OneWay}" Style="{StaticResource SectionHeader}" />
                <DataGrid ItemsSource="{Binding Details.TriageHistory, Mode=OneWay}" Height="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ocena" Binding="{Binding AssessedAtDisplay, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="Kategoria" Width="110">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Category" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Uzasadnienie kliniczne" Binding="{Binding ClinicalJustification, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Parametry życiowe" Binding="{Binding VitalSignsSummary, Mode=OneWay}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding TransfersSectionHeader, Mode=OneWay}" Style="{StaticResource SectionHeader}" />
                <DataGrid ItemsSource="{Binding Details.Transfers, Mode=OneWay}" Height="110">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Czas" Binding="{Binding TransferredAtDisplay, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="Skąd" Binding="{Binding FromZoneName, Mode=OneWay}" Width="200" />
                        <DataGridTextColumn Header="Dokąd" Binding="{Binding ToZoneName, Mode=OneWay}" Width="200" />
                        <DataGridTextColumn Header="Uzasadnienie" Binding="{Binding Reason, Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding OrdersSectionHeader, Mode=OneWay}" Style="{StaticResource SectionHeader}" />
                <DataGrid ItemsSource="{Binding Details.Orders, Mode=OneWay}" Height="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zlecono" Binding="{Binding OrderedAtDisplay, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="Typ" Width="150">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Type" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Opis" Binding="{Binding Description, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Stan" Width="110">
                            <DataGridTextColumn.Binding>
                                <Binding Path="State" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="Pilne" Binding="{Binding IsUrgent, Mode=OneWay}" Width="50" />
                        <DataGridTextColumn Header="Realizacja" Binding="{Binding CompletedAtDisplay, Mode=OneWay}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding AdministrationsSectionHeader, Mode=OneWay}" Style="{StaticResource SectionHeader}" />
                <DataGrid ItemsSource="{Binding Details.Administrations, Mode=OneWay}" Height="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Podano" Binding="{Binding AdministeredAtDisplay, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="Preparat" Binding="{Binding MedicationName, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Dawka" Binding="{Binding Dose, Mode=OneWay}" Width="110" />
                        <DataGridTextColumn Header="Droga" Width="140">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Route" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Uwagi" Binding="{Binding Notes, Mode=OneWay}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding DischargesSectionHeader, Mode=OneWay}" Style="{StaticResource SectionHeader}" />
                <DataGrid ItemsSource="{Binding Details.Discharges, Mode=OneWay}" Height="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Wypisano" Binding="{Binding DischargedAtDisplay, Mode=OneWay}" Width="130" />
                        <DataGridTextColumn Header="Sposób" Width="230">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Type" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Oddział" Binding="{Binding DepartmentName, Mode=OneWay}" Width="180" />
                        <DataGridTextColumn Header="Uzasadnienie" Binding="{Binding Reason, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Zarejestrował" Binding="{Binding RecordedByLogin, Mode=OneWay}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Stopka: zamkniecie okna (Esc dziala, bo IsCancel=True) -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Zamknij" IsCancel="True" MinWidth="110" />
        </DockPanel>
    </Grid>
</Window>
