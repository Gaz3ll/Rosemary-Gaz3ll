<Window x:Class="SOR.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SOR.Presentation"
        mc:Ignorable="d"
        Title="SOR — System Obsługi Ratunkowej"
        Height="820" Width="1280"
        WindowStartupLocation="CenterScreen">

    <!-- Wszystkie kolory pochodzą ze słownika motywu (DynamicResource), dzięki czemu
         przełącznik motywu przemalowuje aplikację bez zmiany tego pliku. -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">

        <!-- ===================== EKRAN LOGOWANIA ===================== -->
        <Border Background="{DynamicResource AppBackgroundBrush}"
                Visibility="{Binding Session.IsAuthenticated, Converter={StaticResource InverseBoolToVisibility}}">
            <Border Width="380" Padding="28" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.15" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="System Obsługi Ratunkowej" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Logowanie kontekstowe — strefa wynika z grafiku dyżurów (BR-02)."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,16" />

                    <TextBlock Text="Login" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Session.Login, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Hasło" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordBox_PasswordChanged" />

                    <Button Content="Zaloguj się" Command="{Binding Session.LoginCommand}"
                            Margin="0,16,0,0" Padding="12,8" />

                    <TextBlock Text="{Binding Session.ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Visibility="{Binding Session.HasError, Converter={StaticResource BoolToVisibility}}" />

                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding ThemeToggleLabel}"
                                Command="{Binding ToggleThemeCommand}" />
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Konta demonstracyjne: ordynator / lekarz.trm / lekarz.emg / lekarz.int / piel.triage (hasła z dokumentacji)." />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===================== PULPIT ===================== -->
        <Grid Visibility="{Binding Session.IsAuthenticated, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <!-- A. Górny pasek menu i narzędzi -->
                <RowDefinition Height="Auto" />
                <!-- Baner rekomendacji rotacji (BR-07) -->
                <RowDefinition Height="Auto" />
                <!-- B. Panel wyboru jednostki i wyszukiwania -->
                <RowDefinition Height="Auto" />
                <!-- C. Panel zakresu dat i filtrów statusowych -->
                <RowDefinition Height="Auto" />
                <!-- D. Moduły kliniczne albo tabela danych -->
                <RowDefinition Height="*" />
                <!-- E. Dolny pasek zakładek (sub-nawigacja) -->
                <RowDefinition Height="Auto" />
                <!-- Pasek statusu -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

<!-- ============ A. GÓRNY PASEK ZAKŁADEK MODUŁOWYCH I PASEK IKON ============ -->
            <Border Grid.Row="0" Background="{DynamicResource PanelPinkBrush}"
                    BorderBrush="{DynamicResource PanelPinkBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <!-- Poziom górny: zakładki modułów po lewej, etykieta użytkownika po prawej. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,6,0,0">
                            <RadioButton Style="{StaticResource ModuleTab}" GroupName="Moduly" Content="PRZYJĘCIA"
                                         IsChecked="{Binding IsAdmissionsSelected, Mode=OneWay}"
                                         Command="{Binding ShowAdmissionsCommand}" />
                            <RadioButton Style="{StaticResource ModuleTab}" GroupName="Moduly" Content="PORADNIA"
                                         IsChecked="{Binding IsClinicSelected, Mode=OneWay}"
                                         Command="{Binding ShowClinicCommand}" />
                            <RadioButton Style="{StaticResource ModuleTab}" GroupName="Moduly" Content="INNE"
                                         IsChecked="{Binding IsOtherSelected, Mode=OneWay}"
                                         Command="{Binding ShowOtherCommand}"
                                         ToolTip="Moduły kliniczne i profil użytkownika" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6,8,0">
                            <TextBlock Text="{Binding UserLabel}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PanelPinkTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WorkZoneLabel}" Margin="12,0,0,0"
                                       Foreground="{DynamicResource PanelPinkTextBrush}" VerticalAlignment="Center" />
                            <Button Content="{Binding ThemeToggleLabel}" MinWidth="100" Margin="12,0,0,0"
                                    Command="{Binding ToggleThemeCommand}" />
                        </StackPanel>
                    </Grid>

                    <!--
                        Poziom dolny: pasek ikon operacyjnych. Ikony są rysowane wektorowo
                        (Path), aby nie zależeć od bibliotek ikon; podpisy funkcji są wymagane
                        przez specyfikację interfejsu.
                    -->
                    <Border Background="{DynamicResource PanelPinkAltBrush}"
                            BorderBrush="{DynamicResource PanelPinkBorderBrush}" BorderThickness="0,1,0,1"
                            Padding="6,3">
                        <StackPanel Orientation="Horizontal">

                                <!-- Szukaj: lupa. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="Szukaj" Command="{Binding SearchCommand}"
                                        ToolTip="Szukaj pacjenta">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 6.6,1.6 A 5,5 0 1 0 6.6,11.6 A 5,5 0 1 0 6.6,1.6 M 10.5,10.5 L 14.4,14.4" />
                                        <TextBlock Text="Szukaj" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                                <!-- Karta pobytu: karta identyfikacyjna. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="Karta pobytu" Command="{Binding ShowStayCardCommand}"
                                        ToolTip="Karta pobytu">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 1.6,3.4 H 14.4 V 12.6 H 1.6 Z M 1.6,6.4 H 14.4 M 4.2,9 H 9.4" />
                                        <TextBlock Text="Karta pobytu" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                                <!-- Raport: dokument z podsumowaniem. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="Raport z dyżuru" Command="{Binding ShowShiftReportCommand}"
                                        ToolTip="Raport z dyżuru">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 3,1.6 H 9.6 L 13,5 V 14.4 H 3 Z M 9.6,1.6 V 5 H 13 M 5.4,8 H 10.6 M 5.4,11.2 H 10.6" />
                                        <TextBlock Text="Raport" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                                <!-- Konsultacje: dwa dymki rozmowy. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="Konsultacje" Command="{Binding ShowConsultationsCommand}"
                                        ToolTip="Konsultacje">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 1.6,3.4 H 9 V 8.6 H 4.8 L 2.4,11 V 8.6 H 1.6 Z M 8,6 H 14.4 V 11 H 11.6 L 9.2,13.4 V 11 H 8 Z" />
                                        <TextBlock Text="Konsultacje" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                                <!-- Wniosek: dokument z ołówkiem. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="Wniosek" Command="{Binding ShowReferralRequestCommand}"
                                        ToolTip="Wniosek">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 2.6,1.6 H 9.2 L 12.6,5 V 10.4 H 2.6 Z M 9.2,1.6 V 5 H 12.6 M 4.6,7 H 8.8 M 8.6,12.4 L 13.4,7.6 L 14.8,9 L 10,13.8 L 7.8,14.4 Z" />
                                        <TextBlock Text="Wniosek" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                                <!-- Przedstawiciel / Uprawnienia: tarcza. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="Przedstawiciel / Uprawnienia" Command="{Binding ShowRepresentativeCommand}"
                                        ToolTip="Przedstawiciel / Uprawnienia">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 8,1.4 L 14,3.4 V 8 C 14,11.4 11.5,14 8,14.6 C 4.5,14 2,11.4 2,8 V 3.4 Z" />
                                        <TextBlock Text="Przedstawiciel / Uprawnienia" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                                <!-- AMK: zlecenia dla zespołu ratownictwa medycznego. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="AMK" Command="{Binding ShowAmkCommand}"
                                        ToolTip="AMK">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 1.6,5.4 H 8.6 V 11.4 H 1.6 Z M 8.6,7.4 H 12 L 14.4,10 V 11.4 H 8.6 Z M 4,13.6 m -1.4,0 a 1.4,1.4 0 1 0 2.8,0 a 1.4,1.4 0 1 0 -2.8,0 M 11.4,13.6 m -1.4,0 a 1.4,1.4 0 1 0 2.8,0 a 1.4,1.4 0 1 0 -2.8,0 M 4,7.6 H 6.2 M 5.1,6.5 V 8.7" />
                                        <TextBlock Text="AMK" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                                <!-- Wyjdź: drzwi ze strzałką. -->
                            <Button Style="{StaticResource IconToolbarButton}" AutomationProperties.Name="Wyjdź" Command="{Binding ExitCommand}"
                                        ToolTip="Wyjdź">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ToolbarIconPath}"
                                              Data="M 6.4,2.4 H 2.4 V 13.6 H 6.4 M 8.8,8 H 15 M 12.4,5.4 L 15,8 L 12.4,10.6" />
                                        <TextBlock Text="Wyjdź" Style="{StaticResource ToolbarIconLabel}" />
                                    </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- Menu klasycznego systemu windowkowego (dostęp klawiaturowy, F10). -->
                    <Menu Background="Transparent" Foreground="{DynamicResource PanelPinkTextBrush}" FontSize="12">
                        <MenuItem Header="Plik">
                            <MenuItem Header="Odśwież listę pobytów" Command="{Binding SearchCommand}" />
                            <Separator />
                            <MenuItem Header="Wyjdź" Command="{Binding ExitCommand}" />
                        </MenuItem>
                        <MenuItem Header="Moduły">
                            <MenuItem Header="PRZYJĘCIA" Command="{Binding ShowAdmissionsCommand}" />
                            <MenuItem Header="PORADNIA" Command="{Binding ShowClinicCommand}" />
                            <MenuItem Header="INNE" Command="{Binding ShowOtherCommand}" />
                        </MenuItem>
                        <MenuItem Header="Widok">
                            <MenuItem Header="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Border>
            <!-- Baner rekomendacji rotacji (BR-07) -->
            <Border Grid.Row="1" Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="16,8"
                    Visibility="{Binding Session.HasRecommendation, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Przyjmij rotację" Command="{Binding Session.AcceptRecommendationCommand}" />
                        <Button Content="Odrzuć" Command="{Binding Session.DismissRecommendationCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Session.RecommendationText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                </DockPanel>
            </Border>

            <!-- ============ B. PANEL WYBORU JEDNOSTKI I WYSZUKIWANIA ============ -->
            <Border Grid.Row="2" Style="{StaticResource PinkFilterPanel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Jednostka organizacyjna [F2]:" Style="{StaticResource PinkFilterLabel}" />
                    <ComboBox Grid.Column="1" Margin="0,0,16,0"
                              ItemsSource="{Binding Stays.OrganizationalUnits}"
                              SelectedItem="{Binding Stays.OrganizationalUnit}" />
                    <TextBlock Grid.Column="2" Text="Pacjent:" Style="{StaticResource PinkFilterLabel}" />
                    <Grid Grid.Column="3" Margin="0,0,8,0" MinWidth="200">
                        <!-- Pole tekstowe z ikoną lupy (specyfikacja B). -->
                        <TextBox Padding="26,3,6,3" Text="{Binding Stays.PatientSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <Path Style="{StaticResource ToolbarIconPath}" HorizontalAlignment="Left" Margin="6,0,0,0"
                              Data="M 6.6,1.6 A 5,5 0 1 0 6.6,11.6 A 5,5 0 1 0 6.6,1.6 M 10.5,10.5 L 14.4,14.4"
                              IsHitTestVisible="False" />
                    </Grid>
                    <!-- Przycisk wyszukiwania z ikoną lupy. -->
                    <Button Grid.Column="4" MinWidth="110" Command="{Binding Stays.SearchCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ToolbarIconPath}"
                                  Data="M 6.6,1.6 A 5,5 0 1 0 6.6,11.6 A 5,5 0 1 0 6.6,1.6 M 10.5,10.5 L 14.4,14.4" />
                            <TextBlock Text="Szukaj" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ C. ZAKRES DAT I FILTRY STATUSOWE ============ -->
            <Border Grid.Row="3" Style="{StaticResource PinkFilterPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Blok 1, wiersz 1: zakres dat od wraz z nawigacją krokową. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Data od:" Style="{StaticResource PinkFilterLabel}" />
                        <DatePicker Width="190" Margin="0,0,14,0" SelectedDate="{Binding Stays.DateFrom, Mode=TwoWay}" />
                        <Button Style="{StaticResource StepButton}" Content="◀ dzień" Command="{Binding Stays.PreviousDayCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="dzień ▶" Command="{Binding Stays.NextDayCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="◀ miesiąc" Margin="10,0,2,0" Command="{Binding Stays.PreviousMonthCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="miesiąc ▶" Command="{Binding Stays.NextMonthCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="◀ rok" Margin="10,0,2,0" Command="{Binding Stays.PreviousYearCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="rok ▶" Command="{Binding Stays.NextYearCommand}" />
                    </StackPanel>
                    <!-- Blok 1, wiersz 2: zakres dat do wraz z nawigacją krokową. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Data do:" Style="{StaticResource PinkFilterLabel}" />
                        <DatePicker Width="190" Margin="0,0,14,0" SelectedDate="{Binding Stays.DateTo, Mode=TwoWay}" />
                        <Button Style="{StaticResource StepButton}" Content="◀ dzień" Command="{Binding Stays.PreviousDayCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="dzień ▶" Command="{Binding Stays.NextDayCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="◀ miesiąc" Margin="10,0,2,0" Command="{Binding Stays.PreviousMonthCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="miesiąc ▶" Command="{Binding Stays.NextMonthCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="◀ rok" Margin="10,0,2,0" Command="{Binding Stays.PreviousYearCommand}" />
                        <Button Style="{StaticResource StepButton}" Content="rok ▶" Command="{Binding Stays.NextYearCommand}" />
                    </StackPanel>
                    <!-- Blok 2: filtry statusowe w układzie siatki, domyślnie „Wszyscy”. -->
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <RadioButton Content="Wszyscy" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                        <RadioButton Content="Aktualnie w szpitalu" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=CurrentlyInHospital}" />
                        <RadioButton Content="Przeniesieni na oddział" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=TransferredToDepartment}" />
                        <RadioButton Content="Anulowani" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Cancelled}" />
                        <RadioButton Content="Odmowa" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Refused}" />
                        <RadioButton Content="Aktualnie w izbie" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=CurrentlyInBay}" />
                        <RadioButton Content="COVID-19" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=Covid19}" />
                        <RadioButton Content="Brak ubezpieczenia" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=NoInsurance}" />
                        <RadioButton Content="Wypisani bez proc. rol. a w izbie" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=DischargedWithoutFormalities}" />
                        <RadioButton Content="Kategorie – weryfikacja" GroupName="Status" Margin="0,0,14,0" Foreground="{DynamicResource PanelPinkTextBrush}"
                                     IsChecked="{Binding Stays.StatusFilter, Mode=TwoWay, Converter={StaticResource EnumEquals}, ConverterParameter=LedgerVerification}" />
                    </WrapPanel>
                    <!-- Blok 2, kolejny wiersz: dodatkowy filtr „Brak karty odmowy”. -->
                    <CheckBox Grid.Row="3" Content="Brak karty odmowy" Margin="0,8,0,0"
                              Foreground="{DynamicResource PanelPinkTextBrush}"
                              IsChecked="{Binding Stays.WithoutRefusalCard, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ============ MODUŁY KLINICZNE — zakładka INNE ============ -->
            <TabControl Grid.Row="4" Margin="10"
                        Visibility="{Binding IsOtherVisible, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}">
                <TabItem Header="Pulpit strefy">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>

                        <!-- Kolumna 1: rejestracja, kolejka triage, zmiana strefy -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,10,0">
                                <TextBlock Text="Rejestracja pacjenta (BR-03)" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="PESEL (11 cyfr)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Board.Pesel, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Board.PeselDerivedHint, UpdateSourceTrigger=PropertyChanged}"
                                           Style="{StaticResource FieldHint}"
                                           Visibility="{Binding Board.PeselDerivedHint, Converter={StaticResource StringToVisibility}}" />
                                <TextBlock Text="Imię" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Board.FirstName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Nazwisko" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Board.LastName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Data urodzenia (RRRR-MM-DD)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Board.DateOfBirth, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Płeć" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Board.Genders}"
                                          SelectedItem="{Binding Board.Gender}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PolishEnum}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Zgłaszane dolegliwości" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Board.Complaint, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="48" TextWrapping="Wrap" />
                                <Button Content="Zarejestruj pacjenta" Command="{Binding Board.RegisterPatientCommand}"
                                        Margin="0,8,0,0" />

                                <TextBlock Text="Kolejka oczekujących na Triage" Style="{StaticResource SectionHeader}" />
                                <DataGrid ItemsSource="{Binding Board.AwaitingTriage}"
                                          SelectedItem="{Binding Board.SelectedTriagePatient}"
                                          Height="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PESEL" Binding="{Binding Pesel, Mode=OneWay}" Width="100" />
                                        <DataGridTextColumn Header="Pacjent" Binding="{Binding FullName, Mode=OneWay}" Width="*" />
                                        <DataGridTextColumn Header="Triage" Width="80">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="Triage" Mode="OneWay"
                                                         Converter="{StaticResource PolishEnum}" />
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridCheckBoxColumn Header="!" Binding="{Binding IsWaitingTimeExceeded, Mode=OneWay}" Width="30" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Ocena Triage i przydział strefy" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Kategoria" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Board.TriageCategories}"
                                          SelectedItem="{Binding Board.TriageCategory}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PolishEnum}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Uzasadnienie kliniczne" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Board.ClinicalJustification, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="44" TextWrapping="Wrap" />
                                <TextBlock Text="Parametry życiowe" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Board.VitalSigns, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="44" TextWrapping="Wrap" />
                                <Button Content="Wykonaj Triage" Command="{Binding Board.PerformTriageCommand}"
                                        Margin="0,8,0,0" />

                                <TextBlock Text="Przydział ręczny do strefy" Style="{StaticResource FieldLabel}" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Triage w strefie klinicznej przydziela pacjenta automatycznie. Wybór strefy jest potrzebny w module wstępnym lub przy braku wolnych miejsc." />
                                <TextBlock Text="{Binding Board.ZoneAssignmentTargetName, Mode=OneWay}"
                                           Style="{StaticResource FieldHint}" />
                                <ComboBox ItemsSource="{Binding Session.Zones}"
                                          SelectedItem="{Binding Board.SelectedZoneForAssignment}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding ZoneName, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding FreeBeds, Mode=OneWay}" /><Run Text=" wolnych miejsc)" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Przydziel do strefy" Command="{Binding Board.AssignToZoneCommand}"
                                        Margin="0,8,0,0" />

                                <Expander Header="Wniosek o zmianę strefy (BR-05)" Margin="0,16,0,0" IsExpanded="True">
                                    <StackPanel>
                                        <TextBlock Text="Strefa docelowa" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Session.Zones}"
                                                  SelectedItem="{Binding Session.SelectedZoneForChange}"
                                                  DisplayMemberPath="ZoneName" />
                                        <TextBlock Text="Przyczyna" Style="{StaticResource FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding Session.Reasons}"
                                                  SelectedValue="{Binding Session.SelectedReasonCode}"
                                                  SelectedValuePath="Code"
                                                  DisplayMemberPath="Label" />
                                        <TextBlock Text="Komentarz (wymagany dla przyczyny „Inny”)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding Session.ReasonComment, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="44" />
                                        <Button Content="Wyślij wniosek" Command="{Binding Session.RequestZoneChangeCommand}"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Kolumna 2: obciążenie strefy i lista pacjentów -->
                        <Grid Grid.Column="1" Margin="10,8,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SurfaceCard}">
                                <StackPanel>
                                    <TextBlock Text="Obciążenie bieżącej strefy (BR-06)" Style="{StaticResource SectionHeader}" />
                                    <ProgressBar Height="22" Minimum="0" Maximum="100"
                                                 Value="{Binding Board.ZoneOccupancyPercent, Mode=OneWay}" />
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Board.LoadStatusDescription}" />
                                        <TextBlock Text="{Binding Board.FreeBeds, StringFormat='Wolne miejsca: {0}'}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="1" Text="Pacjenci w strefie" Style="{StaticResource SectionHeader}" />

                            <DataGrid Grid.Row="2" ItemsSource="{Binding Board.ZonePatients}"
                                      SelectedItem="{Binding Board.SelectedPatient}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PESEL" Binding="{Binding Pesel, Mode=OneWay}" Width="110" />
                                    <DataGridTextColumn Header="Pacjent" Binding="{Binding FullName, Mode=OneWay}" Width="*" />
                                    <DataGridTextColumn Header="Triage" Width="80">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="Triage" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Stan" Width="110">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="State" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Zlecenia" Binding="{Binding OpenOrderCount, Mode=OneWay}" Width="65" />
                                    <DataGridCheckBoxColumn Header="Blokada" Binding="{Binding IsLocked, Mode=OneWay}" Width="60" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Kolumna 3: karta pacjenta -->
                        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Margin="0,8,0,0">
                            <Grid>
                                <TextBlock Text="Wybierz pacjenta, aby otworzyć kartę."
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding Board.HasSelectedDetails, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding Board.HasSelectedDetails, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel DataContext="{Binding Board.SelectedPatientDetails}">
                                        <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold" />
                                        <TextBlock Margin="0,4,0,0">
                                            <Run Text="PESEL: " /><Run Text="{Binding Pesel, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock>
                                            <Run Text="Strefa: " /><Run Text="{Binding ZoneName, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock>
                                            <Run Text="Triage: " />
                                            <Run Text="{Binding Triage, Mode=OneWay, Converter={StaticResource PolishEnum}}" />
                                            <Run Text="   Stan: " />
                                            <Run Text="{Binding State, Mode=OneWay, Converter={StaticResource PolishEnum}}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Rozpoznanie: " /><Run Text="{Binding Diagnosis, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Text="Warunki blokujące wypis (BR-11)" Style="{StaticResource SectionHeader}" />
                                        <ItemsControl ItemsSource="{Binding DischargeBlockers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Zlecenia lekarskie" Style="{StaticResource SectionHeader}" />
                                        <DataGrid ItemsSource="{Binding Orders}" Height="140">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Typ" Width="110">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="Type" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Opis" Binding="{Binding Description, Mode=OneWay}" Width="*" />
                                                <DataGridTextColumn Header="Stan" Width="95">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="State" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                                <!-- Realizacja zlecenia: lekarz, koordynator oraz ratownik medyczny
                                                     (dla zleceń leku i badania obrazowego) — BR-13. -->
                                                <DataGridTemplateColumn Header="Realizacja" Width="110">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Wykonane"
                                                                    MinWidth="0"
                                                                    Padding="8,3"
                                                                    Margin="0"
                                                                    Command="{Binding DataContext.Board.CompleteOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="Dodaj zlecenie" Style="{StaticResource SectionHeader}" />
                                        <ComboBox ItemsSource="{Binding DataContext.Board.OrderTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  IsEnabled="{Binding DataContext.Board.CanIssueOrders, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.Board.OrderType, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource PolishEnum}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Text="{Binding DataContext.Board.OrderDescription, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Content="Pilne" Margin="0,4"
                                                  IsChecked="{Binding DataContext.Board.OrderUrgent, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Dodaj zlecenie"
                                                IsEnabled="{Binding DataContext.Board.CanIssueOrders, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.Board.AddOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <TextBlock Text="Rozpoznanie ICD-10 (BR-13)" Style="{StaticResource SectionHeader}" />
                                        <TextBox Text="{Binding DataContext.Board.Icd10Code, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Zapisz rozpoznanie"
                                                IsEnabled="{Binding DataContext.Board.CanEnterDiagnosis, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.Board.SetDiagnosisCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <TextBlock Text="Podane leki" Style="{StaticResource SectionHeader}" />
                                        <DataGrid ItemsSource="{Binding Administrations}" Height="140">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Preparat" Binding="{Binding MedicationName, Mode=OneWay}" Width="*" />
                                                <DataGridTextColumn Header="Dawka" Binding="{Binding Dose, Mode=OneWay}" Width="90" />
                                                <DataGridTextColumn Header="Droga" Width="90">
                                                    <DataGridTextColumn.Binding>
                                                        <Binding Path="Route" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                                                    </DataGridTextColumn.Binding>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Godzina" Binding="{Binding AdministeredAtUtc, StringFormat='HH:mm', Mode=OneWay}" Width="60" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Wypis pacjenta z SOR (BR-11): zakończenie leczenia, wypis na własne żądanie
                                             albo przekazanie na inny oddział szpitala. Pole oddziału
                                             pojawia się wyłącznie dla przekazania. -->
                                        <TextBlock Text="Wypis pacjenta z SOR (BR-11)" Style="{StaticResource SectionHeader}" />
                                        <ComboBox ItemsSource="{Binding DataContext.Board.DischargeTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  IsEnabled="{Binding DataContext.Board.CanDischargePatient, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataContext.Board.DischargeType, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource PolishEnum}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid Visibility="{Binding DataContext.Board.IsDepartmentRequired, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                            <ComboBox ItemsSource="{Binding DataContext.Board.Departments, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedItem="{Binding DataContext.Board.SelectedDepartment, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <TextBox Text="{Binding DataContext.Board.DischargeReason, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding DataContext.Board.IsReasonRequired, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Wypisz pacjenta z SOR"
                                                IsEnabled="{Binding DataContext.Board.CanDischargePatient, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.Board.DischargeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <TextBlock Text="Historia wypisów" Style="{StaticResource SectionHeader}" />
                                        <ItemsControl ItemsSource="{Binding Discharges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Type, Mode=OneWay, Converter={StaticResource PolishEnum}}" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding DischargedAtUtc, StringFormat='dd.MM.yyyy HH:mm', Mode=OneWay}" />
                                                        <Run Text=" (" />
                                                        <Run Text="{Binding RecordedByLogin, Mode=OneWay}" />
                                                        <Run Text=")" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Operacje na karcie" Style="{StaticResource SectionHeader}" />
                                        <UniformGrid Columns="1">
                                            <Button Content="Przejmij blokadę"
                                                    Command="{Binding DataContext.Board.LockCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Zwolnij blokadę"
                                                    Command="{Binding DataContext.Board.UnlockCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ===================== FORMULARZ LEKÓW I PAKIETY ===================== -->
                <TabItem Header="Formularz i pakiety">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Kolumna 1: formularz leków + pakiety -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Formularz leków oddziału" Style="{StaticResource SectionHeader}" />
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <Button DockPanel.Dock="Right" Content="Szukaj"
                                            Command="{Binding Catalog.SearchMedicationsCommand}" MinWidth="90" />
                                    <TextBox Text="{Binding Catalog.MedicationTerm, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                </DockPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,4">
                                    <TextBlock Text="Grupa terapeutyczna:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Width="260" Margin="8,0,0,0"
                                              ItemsSource="{Binding Catalog.MedicationCategoryFilters}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding Catalog.MedicationCategoryFilter}" />
                                </StackPanel>

                                <DataGrid Grid.Row="2" ItemsSource="{Binding Catalog.Medications}"
                                          SelectedItem="{Binding Catalog.SelectedMedication}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kod" Binding="{Binding Code, Mode=OneWay}" Width="110" />
                                        <DataGridTextColumn Header="Preparat" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                                        <DataGridTextColumn Header="Moc" Binding="{Binding Strength, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Postać" Binding="{Binding Form, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Grupa" Width="130">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="Category" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Droga" Width="100">
                                            <DataGridTextColumn.Binding>
                                                <Binding Path="Route" Mode="OneWay" Converter="{StaticResource PolishEnum}" />
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridCheckBoxColumn Header="!" Binding="{Binding RequiresCloseMonitoring, Mode=OneWay}" Width="30" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="3" Margin="0,8,0,0" DataContext="{Binding Catalog.SelectedMedication}">
                                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap">
                                        <Run Text="Dawka typowa: " />
                                        <Run Text="{Binding TypicalDose, Mode=OneWay}" />
                                        <Run Text="   Maksymalnie dobowo: " />
                                        <Run Text="{Binding MaxDailyDose, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Text="{Binding DataContext.Catalog.SelectedMedicationWarnings, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="Pakiety medyczne" Style="{StaticResource SectionHeader}" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Grid.ColumnSpan="2">
                                    <Button DockPanel.Dock="Right" Content="Szukaj"
                                            Command="{Binding Catalog.SearchBundlesCommand}" MinWidth="90" />
                                    <TextBox Text="{Binding Catalog.BundleTerm, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                </DockPanel>

                                <ListBox Grid.Row="1" Grid.Column="0" Margin="0,4,8,0"
                                         ItemsSource="{Binding Catalog.Bundles}"
                                         SelectedItem="{Binding Catalog.SelectedBundle}"
                                         DisplayMemberPath="Name" />

                                <DockPanel Grid.Row="1" Grid.Column="1">
                                    <Button Content="Zastosuj pakiet" DockPanel.Dock="Top"
                                            Command="{Binding Catalog.ApplyBundleCommand}" />
                                    <ListBox ItemsSource="{Binding Catalog.SelectedBundle.Items}"
                                             DisplayMemberPath="Description" />
                                </DockPanel>
                            </Grid>
                        </Grid>

                        <!-- Kolumna 2: selektor -->
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource SurfaceBorderBrush}" />

                        <!-- Kolumna 3: zlecenie/podanie leku oraz rozpoznania ICD-10 -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="Zlecenie i podanie leku" Style="{StaticResource SectionHeader}" />
                                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                           Text="{Binding Catalog.SelectedMedication.DisplayName, StringFormat='Wybrany preparat: {0}'}" />
                                <TextBlock Text="Dawka" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Catalog.AdministrationDose, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Notatka z podania" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Catalog.AdministrationNotes, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="44" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Zleć podanie" Margin="0,6,6,0"
                                            Command="{Binding Catalog.OrderSelectedMedicationCommand}" />
                                    <Button Content="Odnotuj podanie" Margin="0,6,0,0"
                                            Command="{Binding Catalog.RecordAdministrationCommand}" />
                                </StackPanel>

                                <TextBlock Text="Rozpoznania ICD-10" Style="{StaticResource SectionHeader}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Szukaj"
                                            Command="{Binding Catalog.SearchDiagnosesCommand}" MinWidth="90" />
                                    <TextBox Text="{Binding Catalog.Icd10Term, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Catalog.Diagnoses}"
                                          SelectedItem="{Binding Catalog.SelectedDiagnosis}"
                                          Height="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kod" Binding="{Binding Code, Mode=OneWay}" Width="90" />
                                        <DataGridTextColumn Header="Rozpoznanie" Binding="{Binding Description, Mode=OneWay}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Kod rozpoznania" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Catalog.Icd10Code, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Zapisz rozpoznanie do karty"
                                        IsEnabled="{Binding Board.CanEnterDiagnosis}"
                                        Command="{Binding Catalog.AssignDiagnosisCommand}" />

                                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                           Text="{Binding Catalog.StatusMessage, StringFormat='Status: {0}'}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>


            <!-- ============ D. GŁÓWNA TABELA DANYCH — zakładka PRZYJĘCIA ============ -->
            <TabControl Grid.Row="4" Margin="10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                        SelectedIndex="{Binding SelectedStayTabIndex, Mode=OneWay}"
                        Visibility="{Binding IsAdmissionsVisible, Converter={StaticResource BoolToVisibility}}">
                <TabItem Header="Karta pobytu">
                    <DataGrid ItemsSource="{Binding Stays.VisibleStays}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" FontSize="12"
                              HorizontalGridLinesBrush="{DynamicResource SurfaceBorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="COVID-19" Binding="{Binding Covid19}" Width="70" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientDisplay}" Width="190" />
                            <DataGridTextColumn Header="Triage" Binding="{Binding TriageDisplay}" Width="60" />
                            <DataGridTextColumn Header="Objawy" Binding="{Binding Symptoms}" Width="200" />
                            <DataGridTextColumn Header="Czas" Binding="{Binding WaitingTimeDisplay}" Width="80" />
                            <DataGridTextColumn Header="Data przyjęcia" Binding="{Binding AdmittedAtDisplay}" Width="130" />
                            <DataGridTextColumn Header="Data wypisu" Binding="{Binding DischargedAtDisplay}" Width="130" />
                            <DataGridTextColumn Header="Nr" Binding="{Binding VisitNumber}" Width="70" />
                            <DataGridTextColumn Header="TOPSOR" Binding="{Binding TopSorNumber}" Width="110" />
                            <DataGridTextColumn Header="Oddział" Binding="{Binding DepartmentName}" Width="140" />
                            <DataGridTextColumn Header="Księga główna" Binding="{Binding MainLedgerBook}" Width="110" />
                            <DataGridTextColumn Header="Ubezp." Binding="{Binding HasInsurance}" Width="70" />
                            <DataGridTextColumn Header="Onkologiczna" Binding="{Binding IsOncological}" Width="100" />
                            <DataGridTextColumn Header="Zgoda" Binding="{Binding ConsentToMedicalTreatment}" Width="70" />
                            <DataGridTextColumn Header="Kat." Binding="{Binding TriageDisplay}" Width="60" />
                            <DataGridTextColumn Header="IDH" Binding="{Binding HospitalizationNumber}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Raport z dyżuru">
                    <DataGrid ItemsSource="{Binding Stays.ShiftReport}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" FontSize="12" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Czas" Binding="{Binding CreatedAt}" Width="150" />
                            <DataGridTextColumn Header="Użytkownik" Binding="{Binding PerformedBy}" Width="140" />
                            <DataGridTextColumn Header="Akcja" Binding="{Binding Action}" Width="200" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Badania obrazowe">
                    <DataGrid ItemsSource="{Binding Stays.ImagingStudies}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" FontSize="12" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Czas zlecenia" Binding="{Binding OrderedAtDisplay}" Width="140" />
                            <DataGridTextColumn Header="Pacjent" Binding="{Binding PatientDisplay}" Width="190" />
                            <DataGridTextColumn Header="Badanie" Binding="{Binding Description}" Width="260" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- ============ ZAKŁADKA PORADNIA — brak danych w modelu domenowym ============ -->
            <Border Grid.Row="4" Margin="10" Style="{StaticResource SurfaceCard}"
                    Background="{DynamicResource SurfaceBrush}"
                    Visibility="{Binding IsClinicVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Style="{StaticResource ToolbarIconPath}" Width="48" Height="48"
                          Stroke="{DynamicResource PanelPinkTextBrush}" StrokeThickness="1"
                          HorizontalAlignment="Center"
                          Data="M 2.4,13.4 H 9.6 V 6.4 H 2.4 Z M 9.6,9.4 H 13.6 L 15.6,12 V 13.4 H 9.6 Z M 12.6,3.4 V 8.4 M 10.1,5.9 H 15.1 M 4,9.6 H 8" />
                    <TextBlock Text="PORADNIA" Style="{StaticResource SectionHeader}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Moduł poradni nie jest zaimplementowany w tym etapie systemu."
                               Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.8"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Pasek statusu -->
            <Border Grid.Row="6" Background="{DynamicResource StatusBarBrush}" Padding="16,6"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Odśwież pulpit"
                            Command="{Binding Board.RefreshCommand}" MinWidth="120" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Stays.StatusMessage}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding Stays.Summary}" VerticalAlignment="Center"
                                   Margin="0,0,16,0" Opacity="0.8" />
                        <TextBlock Text="{Binding ToolbarMessage}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBorderBrush}"
                                   Visibility="{Binding HasToolbarMessage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Board.StatusMessage}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
